# Copy to .env and fill in to enable live Claude narration locally.
# Without this, the narrative layer uses the deterministic template narrator.
# .env is gitignored; never commit a real key.
ANTHROPIC_API_KEY=

# Optional: override the narration model (default: claude-haiku-4-5-20251001)
# RETENTION_RISK_CLAUDE_MODEL=claude-haiku-4-5-20251001
